# Banco (PostgreSQL)
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/correspondentes"

# Segredo dos tokens de login — gere com: openssl rand -hex 32
JWT_SECRET=""

# Porta da API (escuta só em 127.0.0.1; o nginx expõe em /api/)
PORT=3340

# URL pública do frontend (usada nos links enviados aos correspondentes)
APP_URL="https://correspondentes.ivillar.com.br"

# Pasta dos arquivos enviados (procurações, comprovantes)
UPLOAD_DIR="/var/www/plataforma-advogado/uploads"

# Fase 3: libera o cadastro aberto de novos escritórios (true/false)
CADASTRO_ABERTO=false

# Só para ambientes sem acesso a binaries.prisma.sh (não usar no VPS)
# PRISMA_MIGRATE_ADAPTER=1

# Usado só pelo seed para criar o primeiro escritório e o admin
SEED_ESCRITORIO="Nome do Escritório"
SEED_ADMIN_NOME="Nome do Advogado"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_SENHA=""
